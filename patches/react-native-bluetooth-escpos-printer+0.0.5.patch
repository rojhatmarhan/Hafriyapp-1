diff --git a/node_modules/react-native-bluetooth-escpos-printer/RNBluetoothEscposPrinter.podspec b/node_modules/react-native-bluetooth-escpos-printer/RNBluetoothEscposPrinter.podspec
new file mode 100644
index 0000000..a3d1cfd
--- /dev/null
+++ b/node_modules/react-native-bluetooth-escpos-printer/RNBluetoothEscposPrinter.podspec
@@ -0,0 +1,34 @@
+require "json"
+
+package = JSON.parse(File.read(File.join(__dir__, "package.json")))
+
+Pod::Spec.new do |s|
+  s.name         = "RNBluetoothEscposPrinter"
+  s.version      = package["version"]
+  s.summary      = package["description"]
+  s.homepage     = "https://github.com/januslo/react-native-bluetooth-escpos-printer"
+  s.license      = "MIT"
+  s.author       = { "januslo" => "januslo@gmail.com" }
+  s.platform     = :ios, "11.0"
+  s.source       = { :path => "." }
+
+  # Ana modül kaynak dosyaları (ZXingObjC hariç)
+  s.source_files = "ios/*.{h,m}"
+
+  # ZXingObjC — bundled QR kod kütüphanesi
+  s.preserve_paths = "ios/ZXingObjC-3.2.2/**/*"
+
+  # Tüm kaynak dosyaları birlikte derle
+  s.subspec "ZXingObjC" do |zx|
+    zx.source_files    = "ios/ZXingObjC-3.2.2/ZXingObjC/**/*.{h,m}"
+    zx.public_header_files = "ios/ZXingObjC-3.2.2/ZXingObjC/**/*.h"
+    zx.xcconfig = { "OTHER_LDFLAGS" => "-ObjC" }
+  end
+
+  s.xcconfig = { "HEADER_SEARCH_PATHS" => "$(PODS_TARGET_SRCROOT)/ios/ZXingObjC-3.2.2" }
+
+  s.frameworks   = "CoreBluetooth"
+  s.requires_arc = true
+
+  s.dependency "React-Core"
+end
